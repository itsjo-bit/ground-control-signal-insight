# GCSI — Granite AI Agent configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials
#   uvicorn app.main:app --reload --port 8000   (from backend/)
#
# The backend loads these automatically via python-dotenv at startup.

# ---------------------------------------------------------------------------
# IBM Granite API credentials (required for /agent/recommend)
# ---------------------------------------------------------------------------

# Your IBM watsonx.ai API key.
# Obtain from: https://cloud.ibm.com/iam/apikeys
GCSI_GRANITE_API_KEY=your_ibm_watsonx_api_key_here

# Granite inference endpoint URL.
# Default points to the IBM watsonx.ai us-south region.
# Change if your project is in a different region.
GCSI_GRANITE_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation

# Granite model identifier.
# ibm/granite-3-3-8b-instruct is the default; change only if you have
# access to a different Granite model.
GCSI_GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# ---------------------------------------------------------------------------
# Optional: scenario auto-load on server start
# ---------------------------------------------------------------------------

# If set, the server loads this scenario JSON file at startup.
# Example: GCSI_SCENARIO_PATH=data/scenarios/nominal_pass.json
# GCSI_SCENARIO_PATH=
