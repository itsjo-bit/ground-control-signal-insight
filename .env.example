# GCSI â€” AI Agent configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your credentials
#   uvicorn app.main:app --reload --port 8000   (from backend/)
#
# The backend loads these automatically via python-dotenv at startup.

# ---------------------------------------------------------------------------
# IBM Granite / watsonx.ai credentials (required for Granite provider)
# ---------------------------------------------------------------------------

# Your IBM Cloud IAM API key.
# Obtain from: https://cloud.ibm.com/iam/apikeys
# Setting this variable activates the Granite provider.
# Leave blank to use the local rule-based provider (no credentials required).
GCSI_GRANITE_API_KEY=

# Your watsonx.ai project ID.
# Obtain from: watsonx.ai â†’ your project â†’ Manage â†’ General â†’ Project ID
# Required when GCSI_GRANITE_API_KEY is set.
GCSI_GRANITE_PROJECT_ID=

# Granite inference endpoint URL.
# The default points to IBM watsonx.ai us-south.
# Change the region prefix (us-south, eu-de, eu-gb, jp-tok, au-syd) to match
# the region where your watsonx.ai project lives.
# A ?version= query parameter is added automatically if not present.
GCSI_GRANITE_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation

# Granite model identifier.
# ibm/granite-4-h-small is the default.
# Change only if you have access to a different Granite model in your project.
GCSI_GRANITE_MODEL_ID=ibm/granite-4-h-small

# IBM Cloud IAM token endpoint.
# Leave blank to use the default: https://iam.cloud.ibm.com/identity/token
# Only change this if you are using a private IBM Cloud deployment.
# GCSI_GRANITE_IAM_URL=https://iam.cloud.ibm.com/identity/token

# ---------------------------------------------------------------------------
# Google Gemini (optional alternative to IBM Granite)
# ---------------------------------------------------------------------------

# Your Google AI API key.
# Obtain from: https://aistudio.google.com/apikeys
# Setting this variable activates the Gemini provider when GCSI_GRANITE_API_KEY
# is not set.  IBM Granite takes priority when both keys are present.
# Leave blank to use the local rule-based provider (no credentials required).
GCSI_GEMINI_API_KEY=

# Gemini model identifier.
# The default is the current configured model (see gemini_provider.py).
# Override with any Gemini model available to your API key, e.g.:
#   gemini-2.5-flash-lite-preview-06-17   (current default, fast and capable)
#   gemini-2.0-flash                      (stable alternative)
#   gemini-3.x-flash-*                    (Gemini 3.x series when available)
# Leave blank to use the default.
GCSI_GEMINI_MODEL=

# Gemini API request timeout in seconds.
# Increase for high-volume Stage-1 analysis if needed.
# Stage-1 with 50 candidates may exceed the default 30 s on slower connections.
# Example: GCSI_GEMINI_TIMEOUT=120
GCSI_GEMINI_TIMEOUT=

# ---------------------------------------------------------------------------
# Optional: local Ollama provider (alternative to Granite/Gemini)
# ---------------------------------------------------------------------------

# Set to true to use a locally-running Ollama server instead of Granite/Gemini.
# Requires Ollama to be installed and running (https://ollama.com).
# Ignored when GCSI_GRANITE_API_KEY or GCSI_GEMINI_API_KEY is set.
# GCSI_OLLAMA_ENABLED=false
# GCSI_OLLAMA_URL=http://localhost:11434
# GCSI_OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Optional: mission source mode (Phase 6E-C6)
# ---------------------------------------------------------------------------

# Mission source mode for server startup.
# Valid values:
#   synthetic_scenario  — default; loads a synthetic GCSI scenario JSON file.
#   historical_replay   — activates a historical replay bundle (requires
#                         GCSI_REPLAY_DESCRIPTOR below).
#
# If absent or blank, synthetic_scenario is used (backward-compatible default).
# Invalid values cause startup source load to fail with no silent fallback.
#
# GCSI_SOURCE_MODE=historical_replay

# Required when GCSI_SOURCE_MODE=historical_replay.
# Repository-relative path to a committed replay descriptor JSON.
# Must start with data/replays/ and end with .json.
# Do NOT set this to an absolute path, URL, or arbitrary file reference.
# This value is validated and sandboxed — no arbitrary file access is possible.
#
# GCSI_REPLAY_DESCRIPTOR=data/replays/juno_pj62_mwr_v1.json

# ---------------------------------------------------------------------------
# Optional: scenario auto-load on server start (synthetic mode only)
# ---------------------------------------------------------------------------

# If set, the server loads this scenario JSON file at startup.
# Applies to synthetic_scenario mode only. Ignored when
# GCSI_SOURCE_MODE=historical_replay.
#
# If NOT set, the server defaults to the canonical ASTERIA-7 demo scenario
# (asteria7_thermal_priority_contact_v1.json), resolved automatically.
#
# Relative paths are resolved from the working directory where uvicorn is run.
# For maximum portability, prefer absolute paths when overriding.
#
# Example (relative, from backend/):
#   GCSI_SCENARIO_PATH=../data/scenarios/nominal_pass.json
# Example (absolute):
#   GCSI_SCENARIO_PATH=/home/user/gcsi/data/scenarios/nominal_pass.json
# GCSI_SCENARIO_PATH=

# ---------------------------------------------------------------------------
# Optional: explicit AI provider selection
# ---------------------------------------------------------------------------

# Force a specific provider regardless of which API keys are set.
# Valid values: granite | gemini | ollama | local
# Leave blank to use automatic selection (recommended).
# GCSI_AI_PROVIDER=
